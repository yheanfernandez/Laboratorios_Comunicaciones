options:
  name: 'lab1_potencia'
  id: 'options'
  parameters:
    author: 'CIT2111 - Comunicaciones Digitales'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Laboratorio 1 - Actividad Previa'
    gen_cmake: 'On'
    gen_linking: 'dynamic'
    generate_options: 'qt_gui'
    hier_block_src_path: '.:'
    id: 'lab1_potencia'
    max_nouts: '0'
    output_language: 'python'
    placement: '(0,0)'
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: 'prompt'
    sizing_mode: 'fixed'
    thread_safe_setters: ''
    title: 'Lab 1 - Medicion de potencia de la sinusoide'
    window_size: '(1000,1000)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: 'enabled'
blocks:
- name: 'samp_rate'
  id: 'variable'
  parameters:
    comment: 'Frecuencia de muestreo [Hz]'
    value: '500e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: 'enabled'
- name: 'f_sin'
  id: 'variable'
  parameters:
    comment: 'Frecuencia de la sinusoide [Hz]'
    value: '1e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: 'enabled'
- name: 'A'
  id: 'variable'
  parameters:
    comment: 'Amplitud de la sinusoide'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 12]
    rotation: 0
    state: 'enabled'
- name: 'N'
  id: 'variable'
  parameters:
    comment: 'Muestras en un periodo de la sinusoide'
    value: 'int(samp_rate/f_sin)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: 'enabled'
- name: 'analog_sig_source_x_0'
  id: 'analog_sig_source_x'
  parameters:
    affinity: ''
    alias: ''
    amp: 'A'
    comment: 'Sinusoide a medir'
    freq: 'f_sin'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: 'samp_rate'
    showports: 'False'
    type: 'float'
    waveform: 'analog.GR_COS_WAVE'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 156]
    rotation: 0
    state: 'enabled'
- name: 'blocks_throttle_0'
  id: 'blocks_throttle'
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: 'samp_rate'
    type: 'float'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 172]
    rotation: 0
    state: 'enabled'
- name: 'blocks_multiply_xx_0'
  id: 'blocks_multiply_xx'
  parameters:
    affinity: ''
    alias: ''
    comment: 'x(t)*x(t) = x^2(t)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: 'float'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 168]
    rotation: 0
    state: 'enabled'
- name: 'blocks_moving_average_xx_0'
  id: 'blocks_moving_average_xx'
  parameters:
    affinity: ''
    alias: ''
    comment: 'Promedio temporal: E[x^2] = potencia'
    length: 'N'
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1.0/N'
    type: 'float'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 168]
    rotation: 0
    state: 'enabled'
- name: 'qtgui_number_sink_0'
  id: 'qtgui_number_sink'
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: '("black", "black")'
    comment: ''
    factor1: '1'
    graph_type: 'qtgui.NUM_GRAPH_NONE'
    gui_hint: ''
    label1: 'Potencia sinusoide [W]'
    max: '2'
    min: '0'
    name: '"Potencia medida"'
    nconnections: '1'
    type: 'float'
    unit1: 'W'
    update_time: '0.10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 156]
    rotation: 0
    state: 'enabled'
connections:
- - 'analog_sig_source_x_0'
  - '0'
  - 'blocks_throttle_0'
  - '0'
- - 'blocks_throttle_0'
  - '0'
  - 'blocks_multiply_xx_0'
  - '0'
- - 'blocks_throttle_0'
  - '0'
  - 'blocks_multiply_xx_0'
  - '1'
- - 'blocks_multiply_xx_0'
  - '0'
  - 'blocks_moving_average_xx_0'
  - '0'
- - 'blocks_moving_average_xx_0'
  - '0'
  - 'qtgui_number_sink_0'
  - '0'
metadata:
  file_format: 1
  grc_version: '3.10.9.2'
