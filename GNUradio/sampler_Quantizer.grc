- name: 'sampler'
  id: 'epy_block'
  parameters:
    affinity: ''
    alias: ''
    comment: 'SAMPLER (S&H sin retorno a cero)'
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      from gnuradio import gr


      class blk(gr.sync_block):
          """
          Sampler: sample & hold SIN retorno a cero (figura 2.b de la guia).

          Entrada 0 : senal sinusoidal.
          Entrada 1 : senal cuadrada de control (niveles 0 / 1).
          Salida  0 : senal PAM plana. En cada flanco de subida de la cuadrada se
                      toma una muestra y se mantiene durante TODO el periodo Ts,
                      hasta el siguiente flanco (ya no vuelve a cero).
          """

          def __init__(self):
              gr.sync_block.__init__(
                  self,
                  name='Sampler',
                  in_sig=[np.float32, np.float32],
                  out_sig=[np.float32]
              )
              self.umbral = 0.5           # decide si el pulso esta en alto
              self.ctrl_prev = False      # estado del pulso en la muestra anterior
              self.valor_retenido = 0.0   # ultima muestra tomada

          def work(self, input_items, output_items):
              in_data = input_items[0]
              in_ctrl = input_items[1]
              out = output_items[0]
              n = len(out)

              # 1) Pulso en alto / bajo
              activo = in_ctrl[:n] > self.umbral

              # 2) Flancos de subida
              anterior = np.concatenate(([self.ctrl_prev], activo[:-1]))
              flancos = activo & ~anterior

              # 3) Indice del ultimo flanco ocurrido para cada muestra
              idx = np.maximum.accumulate(np.where(flancos, np.arange(n), -1))

              # 4) Valor retenido (si aun no hay flanco en este bloque de datos,
              #    se usa el que venia de la llamada anterior)
              valores = np.where(idx >= 0,
                                 in_data[np.maximum(idx, 0)],
                                 self.valor_retenido)

              # 5) Sin retorno a cero: la muestra se mantiene todo el periodo
              out[:] = valores

              # 6) Guardar estado para la siguiente llamada
              self.valor_retenido = float(valores[-1])
              self.ctrl_prev = bool(activo[-1])
              return len(out)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 236]
    rotation: 0
    state: 'enabled'
    _io_cache: '(''Sampler'', ''blk'', [], [(''0'', ''float'', 1), (''1'', ''float'', 1)], [(''0'', ''float'', 1)], '''', [])'
    _source_code_hash: ''
- name: 'quantizer'
  id: 'epy_block'
  parameters:
    affinity: ''
    alias: ''
    comment: 'QUANTIZER'
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      from gnuradio import gr


      class blk(gr.sync_block):
          """
          Quantizer: cuantizador uniforme (mid-rise) de N_bits sobre [-M_p, +M_p].

          N_bits : numero de bits del cuantizador  ->  L = 2**N_bits niveles
          M_p    : valor maximo de entrada (fondo de escala)

          Paso de cuantizacion:  delta = 2*M_p / L
          Cada muestra se reemplaza por el centro del escalon que le corresponde.
          """

          def __init__(self, N_bits=4, M_p=1.0):
              gr.sync_block.__init__(
                  self,
                  name='Quantizer',
                  in_sig=[np.float32],
                  out_sig=[np.float32]
              )
              self.N_bits = N_bits
              self.M_p = M_p

          def work(self, input_items, output_items):
              x = input_items[0]
              out = output_items[0]

              # Se recalcula en cada llamada para que el slider de N_bits
              # cambie el cuantizador en vivo
              N = int(round(self.N_bits))
              Mp = float(self.M_p)
              L = 2 ** N                      # numero de niveles
              delta = 2.0 * Mp / L            # paso de cuantizacion

              # 1) Limitar al fondo de escala (evita sobrecarga)
              xc = np.clip(x, -Mp, Mp)

              # 2) Indice del escalon: de -L/2 a L/2-1
              k = np.floor(xc / delta)
              k = np.clip(k, -L / 2, L / 2 - 1)

              # 3) Valor cuantizado = centro del escalon
              out[:] = (k + 0.5) * delta
              return len(out)
    N_bits: 'N_bits'
    M_p: 'M_p'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 236]
    rotation: 0
    state: 'enabled'
    _io_cache: '(''Quantizer'', ''blk'', [(''N_bits'', ''4''), (''M_p'', ''1.0'')], [(''0'', ''float'', 1)], [(''0'', ''float'', 1)], '''', [''M_p'', ''N_bits''])'
    _source_code_hash: ''
